# Private operator configuration. Populate these locally; never commit real values.
ROLEPLAY_CORE_BASE_URL=http://host.docker.internal:8001
ROLEPLAY_CORE_AI_BASE_URL=http://host.docker.internal:8000
ROLEPLAY_HAI_BASE_URL=http://host.docker.internal:3028
ROLEPLAY_ORGANIZATION_ID=REPLACE_WITH_CORE_BACKEND_ORGANIZATION_UUID
ROLEPLAY_OIDC_TOKEN_URL=https://identity.example/auth/realms/example/protocol/openid-connect/token
ROLEPLAY_OIDC_CLIENT_ID=conversation-roleplay
ROLEPLAY_OIDC_CLIENT_SECRET=REPLACE_WITH_DEDICATED_CLIENT_SECRET
ROLEPLAY_CORE_AI_SERVICE_KEY=REPLACE_WITH_CORE_AI_PROXY_SERVICE_KEY
ROLEPLAY_CORE_AI_APP_ID=conversation-roleplay
ROLEPLAY_CORE_AI_APP_KEY=REPLACE_WITH_DEDICATED_CORE_AI_APP_KEY
# At least 32 random characters; separate from the browser's CSRF token.
ROLEPLAY_DEPLOY_TOKEN=REPLACE_WITH_RANDOM_DEPLOYMENT_CONTROL_TOKEN
# Only for a reviewed product-specific HAI proposal integration:
ROLEPLAY_HAI_APP_ID=REPLACE_WITH_NEGOTIATED_PRODUCT_APP_ID
ROLEPLAY_HAI_APP_KEY=REPLACE_WITH_NEGOTIATED_PRODUCT_APP_KEY
